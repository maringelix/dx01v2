# Deploy-time values for the aws overlays (KEY=VALUE, no quotes). scripts/deploy-aws.sh writes the
# real params.env from the SSM parameters /tx01v2/lab/* (docs/CONTRACT.md) into a temporary copy of
# deploy/k8s; CI renders and validates the overlays with this example file. Placeholders only:
# the documentation account ID 123456789012, an all-zero commit SHA and made-up UUIDs.
API_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/dx01v2/api:0000000000000000000000000000000000000000
MESH_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/dx01v2/api:0000000000000000000000000000000000000000
WEB_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/dx01v2/web:0000000000000000000000000000000000000000
WAF_ACL_ARN=arn:aws:wafv2:us-east-1:123456789012:regional/webacl/tx01v2-lab/0f1e2d3c-4b5a-6978-8a9b-0c1d2e3f4a5b
VPC_CIDR=10.0.0.0/16
ALB_SOURCE_CIDR=10.0.0.0/23
ALB_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/01234567-89ab-cdef-0123-456789abcdef
APP_DOMAIN_NAME=app.example.org
DB_ENDPOINT=tx01v2-lab-postgres.example.us-east-1.rds.amazonaws.com
